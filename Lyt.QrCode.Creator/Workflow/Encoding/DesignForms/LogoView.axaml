<UserControl 
	x:Class="Lyt.QrCode.Creator.Workflow.Encoding.DesignForms.LogoView"
	xmlns:vm="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding.DesignForms"
	x:DataType="vm:LogoViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:shared="clr-namespace:Lyt.QrCode.Creator.Workflow.Shared"	
	>
	<Grid> 
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />	<!-- Image Prompt  --> 
			<RowDefinition Height="140" />   <!-- Drop zone  --> 
			<RowDefinition Height="40" />	<!-- Size Prompt  --> 
			<RowDefinition Height="40" />   <!-- Size Slider   --> 
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="40" />
			<ColumnDefinition Width="480" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="1" Grid.Row="0" 
			Margin="12 0 0 0"
			Text="The image at the center of the QR code should be exactly square."
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<shared:DropView
			Grid.Column="1" Grid.Row="1"
			DataContext="{Binding DropViewModel}"
			/>
		<TextBlock
			Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" 
			Margin="12 0 0 0"
			Text="Logo size, as a percentage of the QR code size."
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<Slider 
			Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" 
			Margin="12 -24 64 4 "
			VerticalAlignment="Center" HorizontalAlignment="Stretch"
			TickFrequency="1.0"
			TickPlacement="BottomRight"
			IsSnapToTickEnabled="True"
			SmallChange="1" LargeChange="5"
			Minimum="10"
			Maximum="35"
			Value="{Binding LogoSizeSliderValue}"
			/>
		<TextBlock
			Grid.Row="3" Grid.Column="2" 
			Margin="0 -20 0 0"
			Theme="{StaticResource Large}"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			Text="{Binding LogoSizeString}"
			/>
	</Grid>
</UserControl>
