<UserControl 
	x:Class="Lyt.QrCode.Creator.Workflow.Encoding.DesignForms.LogoView"
	xmlns:vm="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding.DesignForms"
	x:DataType="vm:LogoViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:shared="clr-namespace:Lyt.QrCode.Creator.Workflow.Shared"	
	>
	<Grid> 
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />	<!-- Image Prompt  --> 
			<RowDefinition Height="140" />   <!-- Drop zone  --> 
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="40" />
			<ColumnDefinition Width="480" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="1" Grid.Row="0" 
			Text="The image at the center of the QR code should be exactly square."
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<shared:DropView
			Grid.Column="1" Grid.Row="1"
			DataContext="{Binding DropViewModel}"
			/>
	</Grid>
</UserControl>
