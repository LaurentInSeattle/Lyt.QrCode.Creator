<UserControl 
	x:Class="Lyt.QrCode.Creator.Workflow.Encoding.DesignForms.FrameView"
	xmlns:vm="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding.DesignForms"
	x:DataType="vm:FrameViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	>
	<Grid> 
		<Grid.RowDefinitions>
			<RowDefinition Height="32" />
			<RowDefinition Height="52" />
			<RowDefinition Height="40" />
			<RowDefinition Height="40" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280" />
			<ColumnDefinition Width="20" />
			<ColumnDefinition Width="280" />
		</Grid.ColumnDefinitions>
		<TextBlock
			Grid.Column="0" Grid.Row="0" 
			Margin="0"
			Text="Background Color"
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Stretch" HorizontalAlignment="Left"
			/>
		<TextBlock
			Grid.Column="2" Grid.Row="0" 
			Margin="0"
			Text="Foreground Color"
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Stretch" HorizontalAlignment="Left"
			/>
		<ColorPicker
			Grid.Column="0" Grid.Row="1" 
			Width="280" Height="40"
			Color="{Binding BackgroundColor}"
			ColorModel="Rgba"
			Foreground="{StaticResource LightAqua_0_120}"
			IsAlphaEnabled="False"
			IsAlphaVisible="False"
			VerticalAlignment="Center" HorizontalAlignment="Stretch" 
			> 
		</ColorPicker>
		<ColorPicker
			Grid.Column="2" Grid.Row="1" 
			Width="280" Height="40"
			Color="{Binding ForegroundColor}"
			ColorModel="Rgba"
			Foreground="{StaticResource LightAqua_0_120}"
			IsAlphaEnabled="False"
			IsAlphaVisible="False"
			VerticalAlignment="Center" HorizontalAlignment="Stretch" 
			> 
		</ColorPicker>
		<TextBlock
			Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" 
			Text="Optional frame labels:"
			Theme="{StaticResource Medium}"
			Margin="0"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<TextBox
			x:Name="TextTopTextBox"
			Grid.Column="0" Grid.Row="3"
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			PlaceholderText="Text above the QR code."
			MaxLength="40"
			Text="{Binding TextTop}"
			Margin="0"
			/>
		<TextBox
			x:Name="TextBottomTextBox"
			Grid.Column="2" Grid.Row="3"
			VerticalContentAlignment="Center" 
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			PlaceholderText="Text below the QR code."
			MaxLength="40"
			Text="{Binding TextBottom}"
			Margin="0"
			/>
	</Grid>
</UserControl>
