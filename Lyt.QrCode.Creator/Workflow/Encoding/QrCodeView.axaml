<UserControl 
	x:Class="Lyt.QrCode.Creator.Workflow.Encoding.QrCodeView"
	xmlns:vm="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding"
	x:DataType="vm:QrCodeViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"
	>
	<Grid		
		ShowGridLines="False"
		>
		<Grid.RowDefinitions>
			<RowDefinition Height="80" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" /> <!-- Light simulation -->
			<RowDefinition Height="8" />
			<RowDefinition Height="80" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" 
			Margin="26 0 0 0"
			Theme="{StaticResource H1}"
			Text="{Binding DecodingStatusText}"
			Foreground="{Binding DecodingStatusColor}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<glyphs:GlyphButton
			Style="{StaticResource ViewIconButton}"
			IsDisabled="{Binding !HasData}"
			HorizontalAlignment="Right" VerticalAlignment="Center"
			Grid.Row="0"
			Width="280" Height="54"
			Margin="0 4 0 4"
			FontSize="24"
			GlyphSource="save"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="Save QR Code"
			Command="{Binding OnSave}"
			/>
		<Grid
			Grid.Row="1"
			>			
			<Grid
				x:Name="FrameGrid"
				IsVisible="{Binding ShowPrimaryImage}"
				ShowGridLines="False"
				> 
			  <Grid.RowDefinitions>
					<RowDefinition Height="0" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="0" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="0" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="0" />
				</Grid.ColumnDefinitions>
				<TextBlock
					x:Name="TopTextBlock"
					Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" 
					Margin="0"
					Theme="{StaticResource H1}"
					TextAlignment="Center"
					VerticalAlignment="Center" HorizontalAlignment="Stretch"
					/>
				<TextBlock
					x:Name="BottomTextBlock"
					Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" 
					Margin="0 -4 0 0"
					Theme="{StaticResource H3}"
					TextAlignment="Center"
					VerticalAlignment="Center" HorizontalAlignment="Stretch"
					/>
			</Grid>
			<Grid
				x:Name="TestImageGrid"
				IsVisible="{Binding ShowTestImage}"
				Width="{Binding TestImageWidth}"
				Height="{Binding TestImageHeight}"
				>
				<Image		
					Source="{Binding ImageSource}"	
					/>
				<Rectangle
					Fill="{Binding ExposureColor}"
					Opacity="{Binding ExposureOpacity}"
					VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
					/>
				<Rectangle
					Fill="{Binding TemperatureColor}"
					Opacity="{Binding TemperatureOpacity}"
					VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
					/>
			</Grid>
		</Grid>
		<!-- Lighting Simulation -->
		<Grid
			Grid.Row="2"
			> 
			<Grid.RowDefinitions>
				<RowDefinition Height="8" />	<!-- Spacer --> 
				<RowDefinition Height="40" />	<!-- Exposure Prompt  --> 
				<RowDefinition Height="40" />   <!-- Exposure Slider   --> 
				<RowDefinition Height="40" />	<!-- Temperature Prompt  --> 
				<RowDefinition Height="40" />   <!-- Temperature Slider   --> 
				<RowDefinition Height="60" />   <!-- Decode Result --> 
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="40" />
				<ColumnDefinition Width="*" /> <!-- Sliders --> 
				<ColumnDefinition Width="16" /> <!-- Spacer -->
				<ColumnDefinition Width="290" /> <!-- Buttons -->
			</Grid.ColumnDefinitions>
		<glyphs:GlyphButton
			Grid.Column="3" Grid.Row="2" 
			Style="{StaticResource ViewIconButton}"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			Width="280" Height="54"
			Margin="0 -16 0 0"
			FontSize="24"
			GlyphSource="text_align_distributed"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="Try Decode"
			Command="{Binding OnTryDecodeTestImage}"
			/>
		<glyphs:GlyphButton
			Grid.Column="3" Grid.Row="4" 
			Style="{StaticResource ViewIconButton}"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			Width="280" Height="54"
			Margin="0 -16 0 0"
			FontSize="24"
			GlyphSource="broom"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			Text="Reset Simulation"
			Command="{Binding OnResetLighting}"
			/>
		<TextBlock
			Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" 
			Margin="12 0 0 0"
			Text="Simulate the exposure of a photo image of the QR Code."
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<Slider 
			Grid.Row="2" Grid.Column="1" 
			Margin="12 -24 64 4 "
			VerticalAlignment="Center" HorizontalAlignment="Stretch"
			TickFrequency="0.05"
			TickPlacement="BottomRight"
			SmallChange="0.05" LargeChange="0.1"
			Minimum="-0.55" Maximum="0.55"
			Value="{Binding ExposureSliderValue}"
			/>
		<TextBlock
			Grid.Row="2" Grid.Column="1" 
			Margin="0 -20 0 0"
			Theme="{StaticResource Large}"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			Text="{Binding ExposureString}"
			/>
		<TextBlock
			Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" 
			Margin="12 0 0 0"
			Text="Simulate the color temperature of a photo image of the QR Code."
			Theme="{StaticResource Medium}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<Slider 
			Grid.Row="4" Grid.Column="1" 
			Margin="12 -24 64 4 "
			VerticalAlignment="Center" HorizontalAlignment="Stretch"
			TickFrequency="0.05"
			TickPlacement="BottomRight"
			SmallChange="0.05" LargeChange="0.1"
			Minimum="-0.45" Maximum="0.45"
			Value="{Binding TemperatureSliderValue}"
			/>
		<TextBlock
			Grid.Row="4" Grid.Column="1" 
			Margin="0 -20 0 0"
			Theme="{StaticResource Large}"
			VerticalAlignment="Center" HorizontalAlignment="Right"
			Text="{Binding TemperatureString}"
			/>
		<TextBlock
			Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="5" 
			Margin="0"
			Theme="{StaticResource H1}"
			Text="{Binding TestImageDecodingStatusText}"
			Foreground="{Binding TestImageDecodingStatusColor}"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		</Grid>
		<TextBlock
			Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
			Margin="26 0 0 0"
			Text="{Binding ContentType}"
			Theme="{StaticResource H1}"
			Foreground="{StaticResource Secondary.TextColor}"
			TextWrapping="Wrap"
			TextAlignment="Left"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
		<TextBlock
			Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" 
			Margin="26 0 0 0"
			Text="{Binding RawContent}"
			Theme="{StaticResource H3}"
			Foreground="{StaticResource Secondary.TextColor}"
			TextWrapping="Wrap"
			TextAlignment="Center"
			VerticalAlignment="Center" HorizontalAlignment="Left"
			/>
	</Grid>
</UserControl>
