<UserControl 
	x:Class="Lyt.QrCode.Creator.Workflow.Encoding.EncodingView"
	xmlns:vm="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding"
	x:DataType="vm:EncodingViewModel" 
	
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"

	xmlns:shared="using:Lyt.QrCode.Creator.Controls"
	xmlns:content="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding.ContentForms"
	xmlns:design="clr-namespace:Lyt.QrCode.Creator.Workflow.Encoding.DesignForms"

	Background="Transparent"
	>

	<UserControl.Styles>
		<Style Selector="GridSplitter.wide">
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border 
						Width="16" 
						Background="Transparent" IsHitTestVisible="True">
						<Border BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}"
								Background="{TemplateBinding Background}"
								HorizontalAlignment="Center"
								Width="2"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
	</UserControl.Styles>

	<Grid> 
		<Grid.RowDefinitions>
			<RowDefinition Height="10" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="10" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="10" />
			<ColumnDefinition Width="*" MinWidth="800"/>  
			<ColumnDefinition Width="16" /> 
			<ColumnDefinition Width="840" MinWidth="400"/>
			<ColumnDefinition Width="10" />
		</Grid.ColumnDefinitions>

		<ScrollViewer
			Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
			Margin="2"
			Background="Transparent"
			VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			>
			<WrapPanel
				Background="Transparent"
				>
				<shared:ContainerControl
					x:Name="ContentContainer"
					Title="Data Content"
					Text="Select the type of content to include in your QR code, then populate the corresponding form."
					>
					<shared:ContainerControl.ContainerControlContent>
						<vm:ContentView 
							x:Name="ContentView"
							DataContext="{Binding ContentViewModel}"
							/>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>

				<shared:ContainerControl
					Title="Pick Module Colours"
					Text="Choose here the colours of the modules. A strong contrast is still needed."
					>
					<shared:ContainerControl.ContainerControlContent>
						<design:ColorsView
							x:Name="ColorsView"
							DataContext="{Binding ColorsViewModel}"
							Margin="40 0 0 0"
							/>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>

				<shared:ContainerControl
					Title="Framing your Content "
					Text="You can add a frame around the QR Code to make clear for users what is going to happen when scanning the code."
					>
					<shared:ContainerControl.ContainerControlContent>
						<shared:OptionControl
							OptionText="Add a frame around the QR Code?"
							>
							<shared:OptionControl.OptionControlContent>
								<design:FrameView
									x:Name="FrameView"
									DataContext="{Binding FrameViewModel}"
									Margin="40 0 0 0"
									/>
							</shared:OptionControl.OptionControlContent>
						</shared:OptionControl>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>
				<shared:ContainerControl
					Title="Adding your Logo or Image"		
					Text="QR Code encoding is redondant and allows for the loss of some pixels, thus making room for a logo or image."
					>
					<shared:ContainerControl.ContainerControlContent>
						<shared:OptionControl
							OptionText="Add a Logo in the Center of the QR Code?"
							>
							<shared:OptionControl.OptionControlContent>
								<design:LogoView
									x:Name="LogoView"
									DataContext="{Binding LogoViewModel}"
									/>
							</shared:OptionControl.OptionControlContent>
						</shared:OptionControl>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>
				<shared:ContainerControl
					Title="Add a Background Image"
					Text="{DynamicResource Settings.ReminderSubtitle}"
					>
					<shared:ContainerControl.ContainerControlContent>
						<design:ImageView
							x:Name="ImageView"
							DataContext="{Binding ImageViewModel}"
							/>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>
				<shared:ContainerControl
					Title="Customize Module Shapes"
					Text="{DynamicResource Settings.ReminderSubtitle}"
					>
					<shared:ContainerControl.ContainerControlContent>
						<design:ShapesView
							x:Name="ShapesView"
							DataContext="{Binding ShapesViewModel}"
							/>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>
				<shared:ContainerControl
					Title="Adjust Image Size ~ Select Format"
					Text="{DynamicResource Settings.ReminderSubtitle}"
					>
					<shared:ContainerControl.ContainerControlContent>
						<design:SizeFormatView
							x:Name="SizeFormatView"
							DataContext="{Binding SizeFormatViewModel}"
							/>
					</shared:ContainerControl.ContainerControlContent>
				</shared:ContainerControl>
			</WrapPanel>
		</ScrollViewer>
		<GridSplitter
			Classes="wide"
			Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" 
			MinWidth="2" 
			Width="16" 
			ResizeDirection="Columns"
			ResizeBehavior="PreviousAndNext"
			DragIncrement="2"
			ShowsPreview="False"
			Background="{StaticResource OrangePeel_1_100}" 
			Opacity="0.55"
			/>
		<StackPanel
			Grid.Row="1" Grid.RowSpan="2" Grid.Column="3"
			>			
			<shared:ContainerControl
				x:Name="QrCodeContainer"
				Title="QR Code"
				Text="Save or download your generated QR Code here!"
				>
				<shared:ContainerControl.ContainerControlContent>
					<vm:QrCodeView
						x:Name="QrCodeView"
						DataContext="{Binding QrCodeViewModel}"
						Margin="2"
						Background="Transparent"
						VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
						/>
				</shared:ContainerControl.ContainerControlContent>
			</shared:ContainerControl>
			<shared:ContainerControl
				Title="Test Image"
				Text="Test how reliably your QR code can be scanned in various simulated lighting conditions."
				>
				<shared:ContainerControl.ContainerControlContent>
					<vm:TestImageView
						x:Name="TestImageView"
						DataContext="{Binding TestImageViewModel}"
						Margin="2"
						Background="Transparent"
						VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
						/>
				</shared:ContainerControl.ContainerControlContent>
			</shared:ContainerControl>
		</StackPanel>
	</Grid>
</UserControl>
